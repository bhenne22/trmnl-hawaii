{%- comment -%}
  Hawaii Countdown -- TRMNL private plugin, "Full" layout.
  Data source: data/hawaii.json (polling strategy)

  NOTE: paste this into the TRMNL editor's *Full* tab. Do NOT wrap it in
  <div class="screen"> or <div class="view view--full"> -- the editor adds
  those itself, and nesting a second one makes the view fail to render.
{%- endcomment -%}

{%- comment -%} Some TRMNL setups nest the payload under "data". Handle both. {%- endcomment -%}
{%- unless facts -%}{%- assign facts = data.facts -%}{%- endunless -%}
{%- unless trip_date -%}{%- assign trip_date = data.trip_date -%}{%- endunless -%}
{%- unless trip_label -%}{%- assign trip_label = data.trip_label -%}{%- endunless -%}
{%- unless tz_offset_seconds -%}{%- assign tz_offset_seconds = data.tz_offset_seconds -%}{%- endunless -%}

{%- comment -%} Local-time offset: device setting first, JSON second, UTC last. {%- endcomment -%}
{%- assign offset = trmnl.user.utc_offset -%}
{%- unless offset -%}{%- assign offset = tz_offset_seconds -%}{%- endunless -%}
{%- unless offset -%}{%- assign offset = 0 -%}{%- endunless -%}
{%- assign offset = offset | plus: 0 -%}

{%- comment -%}
  Subtract whole-day indexes rather than seconds, so the number flips exactly
  at local midnight instead of drifting with the hour of the refresh.
{%- endcomment -%}
{%- assign now_local = "now" | date: "%s" | plus: 0 | plus: offset -%}
{%- assign today_index = now_local | divided_by: 86400 -%}
{%- assign trip_index = trip_date | date: "%s" | plus: 0 | divided_by: 86400 -%}
{%- assign sleeps = trip_index | minus: today_index -%}

{%- assign fact_count = facts | size -%}
{%- assign fact_i = sleeps | modulo: fact_count -%}
{%- assign fact = facts[fact_i] -%}

<div class="layout" style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; text-align: center; padding: 0 40px;">

  {%- if sleeps > 1 -%}
    <div style="font-size: 26px; letter-spacing: 2px; text-transform: uppercase;">Sleeps until {{ trip_label }}</div>
    <div style="font-size: 190px; line-height: 0.95; font-weight: 700;">{{ sleeps }}</div>
  {%- elsif sleeps == 1 -%}
    <div style="font-size: 30px; letter-spacing: 2px; text-transform: uppercase;">Just</div>
    <div style="font-size: 190px; line-height: 0.95; font-weight: 700;">1</div>
    <div style="font-size: 34px; font-weight: 700;">more sleep!</div>
  {%- elsif sleeps == 0 -%}
    <div style="font-size: 84px; line-height: 1.1; font-weight: 700;">TODAY!</div>
    <div style="font-size: 34px;">We are going to {{ trip_label }}!</div>
  {%- else -%}
    {%- assign days_since = 0 | minus: sleeps -%}
    <div style="font-size: 84px; line-height: 1.1; font-weight: 700;">Aloha!</div>
    <div style="font-size: 30px;">{{ days_since }} days since {{ trip_label }}</div>
  {%- endif -%}

  <div style="margin-top: 30px; border-top: 3px solid black; padding-top: 16px; max-width: 700px;">
    <div style="font-size: 22px; letter-spacing: 2px; text-transform: uppercase;">Did you know?</div>
    <div style="font-size: 32px; line-height: 1.3; margin-top: 8px;">{{ fact }}</div>
  </div>

</div>

<div class="title_bar">
  <span class="title">{{ trip_label }} Countdown</span>
  <span class="instance">{{ trip_date | date: "%B %-d, %Y" }}</span>
</div>
